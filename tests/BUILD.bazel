load("@rules_python//python:defs.bzl", "py_test")

# Split by filename prefix, one group per package under test -- not a
# single blanket rule, because plugins/claude/hooks, plugins/codex/hooks
# and src/canon_hooks each define same-named top-level modules (_common,
# capture_review, ...) via their own `imports = ["."]`; depending on more
# than one of those py_library targets from the same py_test would merge
# colliding module paths into one runfiles tree. Each group still needs
# no BUILD edit for a new test file -- glob-driven, same as before.

[
    py_test(
        name = src[:-3],
        srcs = [src, "__init__.py"],
        deps = [
            "//plugins/claude/hooks:hooks_lib",
            "//src/canon_mcp:canon_mcp_lib",
        ],
    )
    for src in glob(["test_claude_hooks_*.py"])
]

# *_py39.py is excluded on purpose, not by oversight. Bazel pins a hermetic
# 3.13 (see MODULE.bazel), so a py_test target for it would run the 3.9 floor
# checks on 3.13 and report PASSED -- which reads as proof of a floor it never
# touched. It runs via `just test-py39` and the python39-floor CI job instead.
[
    py_test(
        name = src[:-3],
        srcs = [src, "__init__.py"],
        data = ["//plugins/canon-companion:py_sources"],
    )
    for src in glob(
        ["test_audit_google_python_style*.py"],
        exclude = ["*_py39.py"],
    )
]

# The eval-suite shape checker. `data`, not `deps`: a filegroup of markdown
# and YAML provides no PyInfo, and nothing here is imported -- the test reads
# the files as text. It carries both suites, because a grader is just as
# unpassable in the companion plugin as in this one.
[
    py_test(
        name = src[:-3],
        srcs = [src, "__init__.py"],
        data = [
            "//plugins/canon-companion:eval_sources",
            "//plugins/claude:eval_sources",
            "//plugins/antigravity:eval_sources",
        ],
    )
    for src in glob(["test_evals_*.py"])
]

[
    py_test(
        name = src[:-3],
        srcs = [src, "__init__.py"],
        deps = ["//plugins/codex/hooks:hooks_lib"],
    )
    for src in glob(["test_codex_hooks_*.py"])
]

# Antigravity's own group, for the same runfiles-collision reason the
# comment at the top of this file gives: plugins/antigravity/hooks
# defines the same top-level module names as the other two.
[
    py_test(
        name = src[:-3],
        srcs = [src, "__init__.py"],
        deps = ["//plugins/antigravity/hooks:hooks_lib"],
    )
    for src in glob(["test_antigravity_hooks_*.py"])
]

[
    py_test(
        name = src[:-3],
        srcs = [src, "__init__.py"],
        deps = ["//src/canon_hooks:canon_hooks_lib"],
    )
    for src in glob(["test_canon_hooks_*.py"])
]

[
    py_test(
        name = src[:-3],
        srcs = [src, "__init__.py"],
        deps = ["//src/canon_mcp:canon_mcp_lib"],
    )
    for src in glob(["test_canon_mcp_*.py"])
]

# Pins canon_mcp's copy of the branch-plan path rule to
# src/canon_hooks/plan_header.py's canonical one -- see
# test_branch_plan_path_parity.py's own module docstring. Its own
# explicit target, not folded into either glob group above: it is the
# one test that needs both libraries at once, and canon_hooks and
# canon_mcp define no colliding module names, so depending on both here
# doesn't hit the runfiles collision the split above exists to avoid.
py_test(
    name = "test_branch_plan_path_parity",
    srcs = ["test_branch_plan_path_parity.py", "__init__.py"],
    deps = [
        "//src/canon_hooks:canon_hooks_lib",
        "//src/canon_mcp:canon_mcp_lib",
    ],
)

# Exposes this package's own .py files to the root package's lint/typecheck
# targets -- see plugins/claude/hooks/BUILD.bazel's py_sources for why.
filegroup(
    name = "py_sources",
    srcs = glob(["*.py"]),
    visibility = ["//:__pkg__"],
)
