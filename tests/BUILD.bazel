load("@rules_python//python:defs.bzl", "py_test")

# Glob-driven: a new test_*.py file needs no edit here.
[
    py_test(
        name = src[:-3],
        srcs = [src, "__init__.py"],
        deps = ["//plugins/claude/hooks:hooks_lib"],
    )
    for src in glob(["test_*.py"])
]

# Exposes this package's own .py files to the root package's lint/typecheck
# targets -- see plugins/claude/hooks/BUILD.bazel's py_sources for why.
filegroup(
    name = "py_sources",
    srcs = glob(["*.py"]),
    visibility = ["//:__pkg__"],
)
