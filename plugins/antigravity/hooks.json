{
  "canon-plan-gate": {
    "PreToolUse": [
      {
        "matcher": "replace_file_content|write_to_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/plan_gate.py"
          }
        ]
      }
    ]
  },
  "canon-git-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/git_guard.py"
          }
        ]
      }
    ]
  },
  "canon-save-plan": {
    "PostToolUse": [
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/save_plan.py"
          }
        ]
      }
    ]
  },
  "canon-check-scope": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/check_scope.py"
          }
        ]
      }
    ]
  },
  "canon-fast-check": {
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 hooks/fast_check.py"
          }
        ]
      }
    ]
  },
  "canon-session-context": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 hooks/session_context.py"
      }
    ]
  },
  "canon-stop": {
    "Stop": [
      {
        "type": "command",
        "command": "python3 hooks/stop.py",
        "timeout": 300
      }
    ]
  }
}
