load("@rules_python//python:defs.bzl", "py_library")

# imports = ["."] makes this directory the package root, so both Bazel
# tests and a hook invoked directly by Claude Code (which adds its own
# directory to sys.path before `import _common`) resolve the same module
# the same way.
py_library(
    name = "hooks_lib",
    srcs = [
        "_common.py",
        "_config.py",
        "stop.py",
        "save_plan.py",
        "session_start.py",
        "__init__.py",
    ],
    imports = ["."],
    visibility = ["//tests:__pkg__"],
)

# Exposes this package's own .py files to the root package's lint/typecheck
# targets, which need the whole tree laid out with real repo-relative paths
# -- glob() alone can't cross this package's boundary from outside it.
filegroup(
    name = "py_sources",
    srcs = glob(["*.py"]),
    visibility = ["//:__pkg__"],
)
