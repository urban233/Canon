"""Canon build graph. Step 1: build, test, lint, typecheck -- no runtime
dependencies yet. See docs/plan.md."""

module(name = "canon", version = "0.0.1")

bazel_dep(name = "rules_python", version = "2.3.2")

# Disables implicit __init__.py synthesis (deprecated upstream, see
# https://github.com/bazel-contrib/rules_python/issues/2945). Every real
# package under this repo carries an explicit __init__.py instead -- same
# config CoDev verified clean.
rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.13",
    is_default = True,
)
use_repo(python, "python_3_13")
