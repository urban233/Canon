# Python
__pycache__/
*.pyc
*.egg-info/

# Bazel
bazel-*
MODULE.bazel.lock

# Canon's own local diagnostics only -- never read back to decide anything
# (see plugins/claude/hooks/_common.py). `.canon/config.json` (added in
# Step 2) is committed, so this ignores just the hooks subdirectory rather
# than the whole `.canon/` tree.
.canon/hooks/

# A `claude plugin eval` run's own output -- never committed.
plugins/*/evals/results/

# A Codex contributor's own local project config (e.g. the mcp_servers
# fallback plugins/codex/README.md documents) -- personal, per-checkout,
# never committed, the same reasoning as .canon/hooks/ above.
.codex/

# macOS
.DS_Store

# Editors
.vscode/
.idea/

# Agent worktrees live here (see .bazelignore, which has to exclude the
# same directory for a different reason). `.claude/settings.json` is a
# committable file -- a project-scoped plugin install writes it and a team
# is meant to check it in -- so this ignores the worktrees only, never the
# directory itself.
.claude/worktrees/
